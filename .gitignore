# Compiled output (regenerated by NetBeans/ant build)
Project Files/ProjectTest/build/

# NetBeans local/machine-specific config (not meant to be shared)
Project Files/ProjectTest/nbproject/private/

# Runtime user account/stats data (plaintext passwords - do not commit)
# but keep one example so the repo shows the file format
Project Files/ProjectTest/User Files/*
!Project Files/ProjectTest/User Files/ExampleUser.txt

# Compiled class files anywhere
*.class

# macOS junk
.DS_Store

# Submission bundle (large, not source - keep out of git history)
Project Files/*.docx
Project Files/*.zip
Project Files/*.mp4
