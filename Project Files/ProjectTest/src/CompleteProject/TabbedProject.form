            <Container class="javax.swing.JScrollPane" name="jScrollPane1">
              <AuxValues>
                <AuxValue name="autoScrollPane" type="java.lang.Boolean" value="true"/>
              </AuxValues>

              <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextArea1">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="Upon your first click, an area on the grid will be cleared (blue), this will reveal numbers in the tiles that are adjacent to the uncleared tiles (green).  &#xa;Each number represents the number of mines around that tile (up, left, down, right and the four diagonal corners).  &#xa;Using this, you are to deduce the positions of all mines in the grid.  &#xa;-----------------------------------&#xa;The easy difficulty has 15 mines.  &#xa;The medium difficulty has 30 mines.  &#xa;The hard difficulty has 50 mines.  &#xa;-----------------------------------&#xa;You should right click on tiles that you suspect contain a mine to flag the tile.  You have as many flags as there are mines. You should left click on all other tiles to clear them.  Once you have cleared all of the tiles that do not contain mines the game will end, and you have won.     &#xa;&#xa;Tip: If you are stuck, look for 1s on the grid. These are very useful at identifying mines.   Corner tiles with a number 1 next to them can easily tell you the position of a mine.&#xa;"/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
          </SubComponents>
        </Container>
